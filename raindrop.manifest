// Raindrop Manifest Template
// This template shows examples of all available modules in Raindrop
// Generated service handlers include Hono.js for HTTP services
// Uncomment the modules you want to use in your application

application "teaching-agent-app" {

  service "user" {
    visibility = "private"
  }

  service "course" {
    visibility = "public"
  }

  service "slide" {
    visibility = "public"
  }

  service "session" {
    visibility = "private"
  }

  service "interaction" {
    visibility = "private"
  }

  service "agent" {
    visibility = "private"
  }

  service "transcription" {
    visibility = "private"
  }

  kv_cache "kv_cache" {}

  env "ANTHROPIC_API_KEY" {
    secret = true
  }

  env "ELEVENLABS_API_KEY" {
    secret = true
  }

  env "COURSE_SERVICE_URL" {}
}
